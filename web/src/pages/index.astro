            function previewInvoicePDF() {
                var token = TOKEN;
                var url = '/api/admin/invoice-settings/preview-pdf';
                // PDF in neuem Tab öffnen (mit Auth-Header via fetch + Blob-URL)
                fetch(url, { headers: { Authorization: 'Bearer ' + token } })
                    .then(function (r) {
                        if (!r.ok)
                            return r.json().then(function (d) {
                                throw new Error(d.message || 'Fehler');
                            });
                        return r.blob();
                    })
                    .then(function (blob) {
                        var blobUrl = window.URL.createObjectURL(blob);
                        window.open(blobUrl, '_blank');
                    })
                    .catch(function (e) {
                        showError(
                            'PDF-Vorschau fehlgeschlagen: ' +
                                (e.message || String(e)) +
                                '\n\nBitte zuerst Einstellungen speichern (Firma und Adresse sind Pflichtfelder).'
                        );
                    });
            }

            function renderPagination(pg, funcName) {
                if (!pg || pg.pages <= 1) return '';
                var html = '<div class="pagination-area">';
                html +=
                    '<span>Seite ' +
                    (pg.page || 1) +
                    ' / ' +
                    (pg.pages || 1) +
                    ' (' +
                    (pg.total || 0) +
                    ' gesamt)</span>';
                html += '<div class="pagination-btns">';
                html +=
                    '<button class="btn btn-ghost btn-xs" onclick="' +
                    funcName +
                    '(' +
                    ((pg.page || 1) - 1) +
                    ')"' +
                    (pg.page <= 1 ? ' disabled' : '') +
                    '>&#9664;</button>';
                html +=
                    '<button class="btn btn-ghost btn-xs" onclick="' +
                    funcName +
                    '(' +
                    ((pg.page || 1) + 1) +
                    ')"' +
                    (pg.page >= pg.pages ? ' disabled' : '') +
                    '>&#9654;</button>';
                html += '</div></div>';
                return html;
            }

            function API(path, opts) {
                opts = opts || {};
                var headers = { 'Content-Type': 'application/json' };
                if (TOKEN) headers['Authorization'] = 'Bearer ' + TOKEN;
                return fetch('/api' + path, Object.assign({ headers: headers }, opts)).then(
                    function (r) {
                        var contentType = r.headers.get('content-type') || '';
                        var hasJson = contentType.includes('application/json');
                        return (
                            hasJson
                                ? r.json().catch(function () {
                                      return {};
                                  })
                                : Promise.resolve({})
                        ).then(function (d) {
                            if (r.status === 401) {
                                var isLoginEndpoint =
                                    path === '/admin/login' || path === '/admin/login/2fa';
                                if (isLoginEndpoint) {
                                    throw d;
                                }
                                TOKEN = '';
                                ROLE = '';
                                USER = '';
                                sessionStorage.removeItem('admin_token');
                                sessionStorage.removeItem('admin_role');
                                sessionStorage.removeItem('admin_user');
                                showLogin('Sitzung abgelaufen. Bitte erneut einloggen.');
                                throw { message: 'Sitzung abgelaufen. Bitte erneut einloggen.' };
                            }
                            if (!r.ok) throw d;
                            return d;
                        });
                    }
                );
            }

            function exportData(type, format) {
                var url = '/api/admin/export/' + type + '?format=' + format;
                fetch(url, { headers: { Authorization: 'Bearer ' + TOKEN } })
                    .then((res) => res.blob())
                    .then((blob) => {
                        var url = window.URL.createObjectURL(blob);
                        var a = document.createElement('a');
                        a.href = url;
                        a.download =
                            type +
                            '_export_' +
                            new Date().toISOString().slice(0, 10) +
                            '.' +
                            format;
                        document.body.appendChild(a);
                        a.click();
                        a.remove();
                    })
                    .catch((e) => showError('Export fehlgeschlagen: ' + e.message));
            }

            var vChart, tChart, fChart, sChart;
            function renderCharts(ana) {
                if (!window.Chart) return;

                const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                const primaryColor = isDark ? '#00bfa5' : '#00897b';
                const primaryBg = isDark ? 'rgba(0, 191, 165, 0.15)' : 'rgba(0, 137, 123, 0.1)';
                const gridColor = isDark ? 'rgba(255, 255, 255, 0.07)' : 'rgba(0, 0, 0, 0.05)';
                const legendColor =
                    getComputedStyle(document.documentElement).getPropertyValue('--text2').trim() ||
                    '#8b9099';
                const doughnutColors = ['#00bfa5', '#5fbf6a', '#e8af34', '#ff5d6c', '#8b9099'];
                Chart.defaults.font.family = "'Roboto', sans-serif";

                // 1. Validations Chart
                const ctxV = document.getElementById('validationsChart').getContext('2d');
                if (vChart) vChart.destroy();
                const valData = ana.validations_per_day || [];
                vChart = new Chart(ctxV, {
                    type: 'line',
                    data: {
                        labels: valData.map(function (d) {
                            return d.date;
                        }),
                        datasets: [
                            {
                                label: 'Validierungen',
                                data: valData.map(function (d) {
                                    return d.count;
                                }),
                                borderColor: primaryColor,
                                backgroundColor: primaryBg,
                                fill: true,
                                tension: 0.4,
                                pointRadius: 4,
                                pointHoverRadius: 6,
                            },
                        ],
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: gridColor },
                                ticks: { color: legendColor },
                            },
                            x: { grid: { display: false }, ticks: { color: legendColor } },
                        },
                    },
                });

                // 2. Types Chart
                const ctxT = document.getElementById('typesChart').getContext('2d');
                if (tChart) tChart.destroy();
                const typeData = ana.type_distribution || [];
                tChart = new Chart(ctxT, {
                    type: 'doughnut',
                    data: {
                        labels: typeData.map(function (d) {
                            return d.type;
                        }),
                        datasets: [
                            {
                                data: typeData.map(function (d) {
                                    return d.count;
                                }),
                                backgroundColor: doughnutColors,
                                borderWidth: 0,
                            },
                        ],
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { color: legendColor, usePointStyle: true },
                            },
                        },
                    },
                });

                // 3. Features Bar Chart
                const ctxF = document.getElementById('featuresChart').getContext('2d');
                if (fChart) fChart.destroy();
                const featUsage = ana.feature_usage || {};
                const featLabels = Object.keys(featUsage);
                const featData = Object.values(featUsage);
                fChart = new Chart(ctxF, {
                    type: 'bar',
                    data: {
                        labels: featLabels,
                        datasets: [
                            {
                                label: 'Aufrufe',
                                data: featData,
                                backgroundColor: primaryColor,
                                borderRadius: 4,
                            },
                        ],
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { grid: { color: gridColor }, ticks: { color: legendColor } },
                            y: { grid: { display: false }, ticks: { color: legendColor } },
                        },
