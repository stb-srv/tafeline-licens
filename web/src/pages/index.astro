            function saveSmtp() {
                var host = document.getElementById('smtp-host').value.trim();
                var port = document.getElementById('smtp-port').value.trim();
                var secure = document.getElementById('smtp-secure').value;
                var user = document.getElementById('smtp-user').value.trim();
                var pass = document.getElementById('smtp-pass').value;
                var from = document.getElementById('smtp-from').value.trim();

                if (!host) {
                    showAlert('smtp-alert', 'Host ist ein Pflichtfeld.', 'error');
                    return;
                }
                if (!user) {
                    showAlert(
                        'smtp-alert',
                        'Benutzername / E-Mail-Adresse ist ein Pflichtfeld.',
                        'error'
                    );
                    return;
                }
                if (!pass) {
                    showAlert(
                        'smtp-alert',
                        'Passwort eingeben. Das Passwort wird nicht angezeigt, muss aber beim Speichern immer eingegeben werden.',
                        'error'
                    );
                    return;
                }

                showAlert('smtp-alert', 'Verbinde mit SMTP-Server&hellip;', 'info');

                var body = {
                    host: host,
                    port: port || '587',
                    secure: secure,
                    user: user,
                    pass: pass,
                    from: from || user,
                };
                API('/admin/smtp', { method: 'POST', body: JSON.stringify(body) })
                    .then(function (d) {
                        showAlert('smtp-alert', esc(d.message || 'SMTP gespeichert.'), 'success');
                        setTimeout(function () {
                            loadSmtp();
                        }, 1500);
                    })
                    .catch(function (e) {
                        var msg = e.message || JSON.stringify(e) || 'Unbekannter Fehler';
                        showAlert('smtp-alert', 'Fehler: ' + esc(msg), 'error');
                    });
            }

            function testSmtp() {
                var to = document.getElementById('smtp-test-to')
                    ? document.getElementById('smtp-test-to').value.trim()
                    : '';
                if (!to) {
                    showAlert('smtp-test-alert', 'Bitte Empfänger-E-Mail eingeben.', 'error');
                    return;
                }
                showAlert(
                    'smtp-test-alert',
                    'Sende Test-E-Mail an ' + esc(to) + '&hellip;',
                    'info'
                );
                API('/admin/smtp/test', { method: 'POST', body: JSON.stringify({ to: to }) })
                    .then(function (d) {
                        showAlert('smtp-test-alert', 'Erfolg: ' + esc(d.message), 'success');
                    })
                    .catch(function (e) {
                        var msg = e.message || JSON.stringify(e) || 'Unbekannter Fehler';
                        showAlert('smtp-test-alert', 'Fehler: ' + esc(msg), 'error');
                    });
            }

