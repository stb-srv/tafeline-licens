            function savePassword() {
                var username = document.getElementById('cp-username').value;
                var pass = document.getElementById('cp-pass').value;
                var pass2 = document.getElementById('cp-pass2').value;
                if (pass.length < 12) {
                    showAlert(
                        'cp-alert',
                        'Passwort muss mindestens 12 Zeichen lang sein.',
                        'error'
                    );
                    return;
                }
                if (pass !== pass2) {
                    showAlert('cp-alert', 'Passwörter stimmen nicht überein.', 'error');
                    return;
                }
                API('/admin/users/' + encodeURIComponent(username) + '/password', {
                    method: 'PATCH',
                    body: JSON.stringify({ password: pass }),
                })
                    .then(function () {
                        closeModal('modal-change-password');
                        showAlert('users-table', '', 'success');
                        loadUsers();
                    })
                    .catch(function (e) {
                        showAlert('cp-alert', esc(e.message || 'Fehler beim Speichern.'), 'error');
                    });
            }

