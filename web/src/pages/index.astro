            .slider:before {
                position: absolute;
                content: '';
                height: 14px;
                width: 14px;
                left: 2px;
                bottom: 2px;
                background-color: var(--text2);
                transition: 0.3s;
                border-radius: 50%;
            }
            input:checked + .slider {
                background-color: var(--primary);
                border-color: var(--primary);
