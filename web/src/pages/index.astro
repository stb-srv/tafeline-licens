            function fmtDate(d) {
                return d
                    ? new Date(d).toLocaleString('de-DE', {
                          day: '2-digit',
                          month: '2-digit',
                          year: 'numeric',
                          hour: '2-digit',
                          minute: '2-digit',
                      })
                    : '\u2014';
            }
            function daysLeft(d) {
                return Math.ceil((new Date(d) - Date.now()) / 86400000);
            }
            function esc(s) {
                return String(s == null ? '' : s)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;');
            }
            function fmtEur(v) {
                return v != null ? parseFloat(v).toFixed(2) + ' \u20AC' : '\u2014';
            }
            function skeletonTable(cols, rows) {
                rows = rows || 5;
                var cell = '<td><div class="skeleton" style="height:13px;width:75%;border-radius:4px">&nbsp;</div></td>';
                var row = '<tr>' + cell.repeat(cols) + '</tr>';
                return '<table class="data-table"><tbody>' + row.repeat(rows) + '</tbody></table>';
            }
            function emptyState(icon, title, text, btnLabel, btnAction) {
                return '<div class="empty-state">' +
                    '<i data-lucide="' + icon + '"></i>' +
                    '<h3>' + title + '</h3>' +
                    '<p>' + text + '</p>' +
                    (btnLabel ? '<button class="btn btn-primary btn-sm" onclick="' + btnAction + '">' + btnLabel + '</button>' : '') +
                    '</div>';
            }

            function safeParse(val, fallback) {
                if (Array.isArray(val)) return val;
                try {
                    return JSON.parse(val || JSON.stringify(fallback));
                } catch (e) {
                    return fallback;
                }
            }

            function showAlert(elId, msg, type) {
                type = type || 'error';
                var el = document.getElementById(elId);
                if (el) el.innerHTML = '<div class="alert alert-' + type + '">' + msg + '</div>';
            }

            function toast(msg, type) {
                var c = document.getElementById('toast-container');
                if (!c) return;
                var t = document.createElement('div');
                t.className = 'toast toast-' + (type || 'info');
                t.textContent = msg;
                c.appendChild(t);
                setTimeout(function () {
                    t.classList.add('toast-out');
                    setTimeout(function () {
                        t.remove();
                    }, 350);
                }, 4000);
            }

