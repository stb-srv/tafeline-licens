            function saveInvoiceSettings() {
                var body = {
                    company_name: document.getElementById('is-company-name').value,
                    invoice_prefix: document.getElementById('is-invoice-prefix').value || 'INV',
                    company_address: document.getElementById('is-company-address').value,
                    company_tax_id: document.getElementById('is-company-tax-id').value || null,
                    company_iban: document.getElementById('is-company-iban').value || null,
                    company_bic: document.getElementById('is-company-bic').value || null,
                    company_bank_name:
                        document.getElementById('is-company-bank-name').value || null,
                    footer_text: document.getElementById('is-footer-text').value || null,
                };

                if (!body.company_name || !body.company_address) {
                    toast('Firma und Adresse sind Pflichtfelder.', 'error');
                    return;
                }

                API('/admin/invoice-settings', {
                    method: 'PUT',
                    body: JSON.stringify(body),
                })
                    .then(function () {
                        closeModal('modal-invoice-settings');
                        toast('Einstellungen erfolgreich gespeichert.', 'success');
                    })
