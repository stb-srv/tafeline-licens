                        var html = devs.length
                            ? '<table class="data-table"><thead><tr><th>Device-ID</th><th>Lizenz-Key</th><th>Typ</th><th>IP</th><th>Zuletzt</th><th>Status</th><th>Aktionen</th></tr></thead><tbody>' +
