            function loadAudit() {
                document.getElementById('audit-list').innerHTML = skeletonTable(4);
                var action = document.getElementById('audit-search')
                    ? document.getElementById('audit-search').value
                    : '';
                var url =
                    '/admin/audit-log?limit=200' +
                    (action ? '&action=' + encodeURIComponent(action) : '');
                API(url)
                    .then(function (d) {
                        var logs = d.logs || [];
                        var colors = {
                            validate_success: 'success',
                            admin_login: 'success',
                            license_created: 'success',
                            license_renewed: 'success',
                            customer_created: 'success',
                            purchase_history_added: 'success',
                            validate_failed: 'warn',
                            heartbeat_failed: 'warn',
                            refresh_failed: 'warn',
                            admin_login_failed: 'error',
                            replay_attack: 'error',
                            license_deleted: 'error',
                        };
                        document.getElementById('audit-list').innerHTML = logs.length
                            ? logs
                                  .map(function (l) {
                                      var cls = colors[l.action] || '';
                                      var iconName =
                                          cls === 'success'
                                              ? 'check-circle'
                                              : cls === 'warn'
                                                ? 'alert-triangle'
                                                : 'x-circle';
                                      var details = '';
                                      try {
                                          var obj =
                                              typeof l.details === 'string'
                                                  ? JSON.parse(l.details)
                                                  : l.details;
                                          details = Object.entries(obj || {})
                                              .map(function (kv) {
                                                  return (
                                                      '<span style="color:var(--text2)">' +
                                                      esc(kv[0]) +
                                                      ': </span>' +
                                                      esc(kv[1])
                                                  );
                                              })
                                              .join(' &nbsp; ');
                                      } catch (ex) {}
                                      return (
                                          '<div class="log-entry ' +
                                          cls +
                                          '">' +
                                          '<i data-lucide="' +
                                          iconName +
                                          '" class="log-icon"></i>' +
                                          '<div class="log-content">' +
                                          '<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.4rem">' +
                                          '<div><strong>' +
                                          esc(l.action) +
                                          '</strong> <span style="color:var(--text2);font-size: var(--text-xs)">von ' +
                                          esc(l.actor || 'system') +
                                          '</span></div>' +
                                          '<div class="log-time">' +
                                          fmtDate(l.ts) +
                                          '</div>' +
                                          '</div>' +
                                          '<div style="margin-top: var(--space-1);font-size: var(--text-sm)">' +
                                          details +
                                          '</div>' +
                                          '</div>' +
                                          '</div>'
                                      );
                                  })
                                  .join('')
                            : emptyState('file-search', 'Kein Audit-Log', 'Es wurden noch keine Aktionen protokolliert.');
                        if (window.lucide) window.lucide.createIcons();
                    })
                    .catch(function (e) {
                        document.getElementById('audit-list').innerHTML =
                            '<div class="alert alert-error">' +
                            esc(e.message || 'Fehler') +
                            '</div>';
                    });
            }

