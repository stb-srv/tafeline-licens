                    });
            }

            function showError(msg, title) {
                document.getElementById('modal-error-title').textContent = title || 'Fehler';
                document.getElementById('modal-error-msg').textContent =
                    msg || 'Ein unbekannter Fehler ist aufgetreten.';
                openModal('modal-error');
            }

            var confirmCallback = null;
            function showConfirm(msg, callback, title) {
                document.getElementById('modal-confirm-title').textContent = title || 'Bestätigung';
                document.getElementById('modal-confirm-msg').textContent = msg || 'Bist du sicher?';
                confirmCallback = callback;
                document.getElementById('modal-confirm-btn').onclick = function () {
                    closeModal('modal-confirm');
                    if (confirmCallback) confirmCallback();
                };
                openModal('modal-confirm');
            }
        </script>

        <!-- ── DSGVO Cookie-Banner ──────────────────────────────────────────── -->
        <div
            id="cookie-banner"
            style="
                display: none;
                position: fixed;
                bottom: 1.5rem;
                left: 1.5rem;
                right: 1.5rem;
                z-index: 9999;
                background: var(--bg2);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                padding: var(--space-6);
                flex-direction: column;
                gap: 1.2rem;
                max-width: 550px;
                box-shadow: var(--shadow-lg);
            "
        >
            <div style="display: flex; align-items: center; gap: 0.8rem">
                <span style="display: inline-flex; color: var(--accent)"
                    ><i data-lucide="cookie" style="width: 1.4em; height: 1.4em"></i
                ></span>
                <div style="flex: 1">
                    <strong
                        style="
                            font-size: var(--text-base);
                            font-family: var(--font-display);
                            color: var(--text);
                        "
                        >Privatsphäre-Einstellungen</strong
                    >
                    <p
                        style="
                            font-size: var(--text-sm);
                            color: var(--text2);
                            margin-top: var(--space-1);
                        "
                    >
                        Wir nutzen Cookies, um die bestmögliche Erfahrung zu bieten. Wählen Sie aus,
                        welche Kategorien Sie zulassen möchten.
                    </p>
                </div>
            </div>

            <div id="cookie-advanced-settings">
                <div class="cookie-option">
                    <div class="cookie-info">
                        <span class="cookie-name"
                            >Essenziell <span class="cookie-badge">Immer aktiv</span></span
                        >
                        <span class="cookie-desc"
                            >Notwendig für Kernfunktionen wie Login, Sicherheit und
                            Design-Präferenzen.</span
                        >
                    </div>
                    <label class="switch"
                        ><input type="checkbox" checked disabled /><span class="slider"></span
                    ></label>
                </div>

                <div class="cookie-option">
                    <div class="cookie-info">
                        <span class="cookie-name">Funktionell</span>
                        <span class="cookie-desc"
                            >Ermöglicht das Laden externer Ressourcen wie Schriften (Google Fonts)
                            und Programm-Bibliotheken (CDNs).</span
                        >
                    </div>
                    <label class="switch"
                        ><input type="checkbox" id="consent-func" checked /><span
                            class="slider"
                        ></span
                    ></label>
                </div>

                <div class="cookie-option" style="opacity: 0.6">
                    <div class="cookie-info">
                        <span class="cookie-name">Analyse & Marketing</span>
                        <span class="cookie-desc"
                            >Aktuell nicht genutzt. Würde helfen zu verstehen, wie die Seite genutzt
                            wird.</span
                        >
                    </div>
                    <label class="switch"
                        ><input type="checkbox" id="consent-analytics" /><span class="slider"></span
                    ></label>
                </div>
            </div>

            <div
                style="
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    flex-wrap: wrap;
                    gap: 1rem;
                    margin-top: var(--space-2);
                    padding-top: var(--space-4);
                    border-top: 1px solid var(--border);
                "
            >
                <div style="display: flex; gap: 0.8rem; font-size: var(--text-sm)">
                    <a
                        onclick="
                            showPublicPage('legal');
                            showLegalTab('impressum');
                        "
                        style="color: var(--text2); cursor: pointer; text-decoration: underline"
                        >Impressum</a
                    >
                    <a
                        onclick="
                            showPublicPage('legal');
                            showLegalTab('datenschutz');
                        "
                        style="color: var(--text2); cursor: pointer; text-decoration: underline"
                        >Datenschutz</a
                    >
                </div>
                <div style="display: flex; gap: 0.8rem">
                    <button
                        class="btn btn-ghost btn-sm"
                        id="btn-cookie-settings"
                        onclick="toggleCookieSettings()"
                    >
                        Einstellungen
                    </button>
                    <button
                        class="btn btn-ghost btn-sm"
                        id="btn-cookie-necessary"
                        onclick="saveConsent(false)"
                    >
                        Nur Notwendige
                    </button>
                    <button
                        class="btn btn-primary btn-sm"
                        id="btn-cookie-all"
                        onclick="saveConsent(true)"
                    >
                        Alle akzeptieren
                    </button>
                    <button
                        class="btn btn-primary btn-sm"
                        id="btn-cookie-save"
                        style="display: none"
                        onclick="saveCustomConsent()"
                    >
                        Speichern
                    </button>
                </div>
            </div>
        </div>

        <script is:inline>
            (function () {
                var consent = localStorage.getItem('cookie_consent');
                if (!consent) {
                    if (document.getElementById('page-admin').classList.contains('active')) return;
                    document.getElementById('cookie-banner').style.display = 'flex';
                } else {
                    applyConsent(JSON.parse(consent));
                }
            })();

            function toggleCookieSettings() {
                var adv = document.getElementById('cookie-advanced-settings');
                var isVisible = adv.style.display === 'block';
                adv.style.display = isVisible ? 'none' : 'block';

                document.getElementById('btn-cookie-necessary').style.display = isVisible
                    ? 'inline-flex'
                    : 'none';
                document.getElementById('btn-cookie-all').style.display = isVisible
                    ? 'inline-flex'
                    : 'none';
                document.getElementById('btn-cookie-save').style.display = isVisible
                    ? 'none'
                    : 'inline-flex';
                document.getElementById('btn-cookie-settings').textContent = isVisible
                    ? 'Einstellungen'
                    : 'Abbrechen';
            }

            function saveConsent(all) {
                var consentObj = {
                    essential: true,
                    functional: all,
                    analytics: all,
                    timestamp: new Date().toISOString(),
                };
                localStorage.setItem('cookie_consent', JSON.stringify(consentObj));
                applyConsent(consentObj);
                document.getElementById('cookie-banner').style.display = 'none';
            }

            function saveCustomConsent() {
                var consentObj = {
                    essential: true,
                    functional: document.getElementById('consent-func').checked,
                    analytics: document.getElementById('consent-analytics').checked,
                    timestamp: new Date().toISOString(),
                };
                localStorage.setItem('cookie_consent', JSON.stringify(consentObj));
                applyConsent(consentObj);
                document.getElementById('cookie-banner').style.display = 'none';
            }

            function applyConsent(consent) {
                if (!consent.functional) {
                    console.log('Functional cookies/resources restricted.');
                }
            }
        </script>

        <!-- Fehler-Modal -->
        <div class="modal-overlay" id="modal-error">
            <div class="modal" style="max-width: 420px; text-align: center">
                <div style="margin-bottom: var(--space-3); color: var(--warning, #f5a623)">
                    <i data-lucide="alert-triangle" style="width: 1.6em; height: 1.6em"></i>
                </div>
                <h3 id="modal-error-title" style="margin-bottom: var(--space-2)">Fehler</h3>
                <p
                    id="modal-error-msg"
                    style="
                        color: var(--text2);
                        font-size: var(--text-sm);
                        margin-bottom: var(--space-6);
                    "
                ></p>
                <div class="modal-footer" style="justify-content: center">
                    <button class="btn btn-primary" onclick="closeModal('modal-error')">OK</button>
                </div>
            </div>
        </div>

        <!-- Bestätigungs-Modal -->
        <div class="modal-overlay" id="modal-confirm">
            <div class="modal" style="max-width: 420px; text-align: center">
                <div style="margin-bottom: var(--space-3); color: var(--accent)">
                    <i data-lucide="help-circle" style="width: 1.6em; height: 1.6em"></i>
                </div>
                <h3 id="modal-confirm-title" style="margin-bottom: var(--space-2)">Bestätigung</h3>
                <p
                    id="modal-confirm-msg"
                    style="
                        color: var(--text2);
                        font-size: var(--text-sm);
                        margin-bottom: var(--space-6);
                    "
                ></p>
                <div class="modal-footer" style="justify-content: center">
                    <button class="btn btn-ghost" onclick="closeModal('modal-confirm')">
                        Abbrechen
                    </button>
                    <button class="btn btn-primary" id="modal-confirm-btn">Ja</button>
                </div>
            </div>
        </div>

        <div id="toast-container"></div>
        <script>
      import Chart from 'chart.js/auto';
      import { createIcons, icons } from 'lucide';
      window.Chart = Chart;
      window.lucide = { createIcons: () => createIcons({ icons }) };
    </script>
</BaseLayout>
