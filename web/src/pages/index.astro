                        <label>Fußzeilentext (optional)</label>
                        <input
                            type="text"
                            id="is-footer-text"
                            placeholder="Vielen Dank für Ihr Vertrauen!"
                        />
                    </div>
                </div>

                <fieldset
                    style="
                        border: 1px solid var(--border);
                        border-radius: var(--radius-md);
                        padding: var(--space-3) var(--space-4);
                        margin: var(--space-2) 0 var(--space-4);
                    "
                >
                    <legend
                        style="
                            font-size: var(--text-sm);
                            font-weight: 500;
                            color: var(--text2);
                            padding: 0 var(--space-2);
                        "
                    >
                        <i
                            data-lucide="landmark"
                            style="width: 1em; height: 1em; vertical-align: -0.15em; color: var(--accent); margin-right: 0.4em;"
                        ></i>Bankverbindung
                    </legend>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem">
                        <div class="form-group" style="margin-bottom: var(--space-2)">
                            <label>Bank / Institut</label>
                            <input
                                type="text"
                                id="is-company-bank-name"
                                placeholder="z.B. Volksbank Muster"
                            />
                        </div>
                        <div class="form-group" style="margin-bottom: var(--space-2)">
                            <label>IBAN</label>
                            <input
                                type="text"
                                id="is-company-iban"
                                placeholder="DE12 3456 7890 1234 5678 90"
                            />
                        </div>
                    </div>
                    <div class="form-group" style="margin-bottom: 0">
                        <label>BIC / SWIFT</label>
                        <input
                            type="text"
                            id="is-company-bic"
                            placeholder="GENODED1xxx"
                            style="max-width: 200px"
                        />
                    </div>
                </fieldset>

                <div class="modal-footer" style="justify-content: space-between">
                    <button
                        class="btn btn-ghost btn-sm"
                        onclick="previewInvoicePDF()"
                        style="gap: 6px"
                    >
                        <i data-lucide="eye" style="width: 14px; height: 14px"></i> PDF Vorschau
                    </button>
                    <div style="display: flex; gap: 8px">
                        <button
                            class="btn btn-ghost"
                            onclick="closeModal('modal-invoice-settings')"
                        >
                            Abbrechen
                        </button>
                        <button class="btn btn-primary" onclick="saveInvoiceSettings()">
                            Speichern
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <script is:inline>
            (function () {
                var saved = localStorage.getItem('theme');
                var preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', saved || preferred);
            })();

            window.addEventListener('DOMContentLoaded', function () {
                updateThemeBtn(localStorage.getItem('theme') || document.documentElement.getAttribute('data-theme') || 'dark');
                if (window.lucide) window.lucide.createIcons();
            });

            function toggleMobileMenu() {
                var menu = document.getElementById('nav-mobile-menu');
                var btn = document.getElementById('nav-hamburger');
                var open = menu.classList.toggle('open');
                btn.setAttribute('aria-expanded', open ? 'true' : 'false');
                if (open && window.lucide) window.lucide.createIcons();
            }
            function closeMobileMenu() {
                var menu = document.getElementById('nav-mobile-menu');
                var btn = document.getElementById('nav-hamburger');
                menu.classList.remove('open');
                if (btn) btn.setAttribute('aria-expanded', 'false');
            }
            document.addEventListener('click', function (e) {
                var menu = document.getElementById('nav-mobile-menu');
                var btn = document.getElementById('nav-hamburger');
                if (menu && menu.classList.contains('open') && !menu.contains(e.target) && e.target !== btn && !btn.contains(e.target)) {
                    closeMobileMenu();
                }
            });

            function updateThemeBtn(theme) {
                var svg = document.getElementById('theme-svg');
                if (!svg) return;
                if (theme === 'dark') {
                    svg.innerHTML =
                        '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path>';
                } else {
                    svg.innerHTML = '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>';
                }
            }

            function toggleTheme() {
                var cur = document.documentElement.getAttribute('data-theme') || 'light';
                var next = cur === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                localStorage.setItem('theme', next);
                updateThemeBtn(next);
                if (TOKEN && document.getElementById('tab-overview').classList.contains('active')) {
                    loadOverview();
                }
            }

            var TOKEN = sessionStorage.getItem('admin_token') || '';
            var ROLE = sessionStorage.getItem('admin_role') || '';
            var USER = sessionStorage.getItem('admin_user') || '';
            var licPage = 1,
                licSearch = '',
                searchTimer;
            var custPage = 1,
                custSearch = '';
            var devPage = 1,
                devSearch = '';
            var phPage = 1,
                phSearch = '';
            var activeSubTab = 'login-log';
            var CUSTS = [];

            var invoices = [];
            var invoicesFiltered = [];

            function fmtDateOnly(d) {
                if (!d) return '—';
                var date = new Date(d);
                if (isNaN(date.getTime())) return String(d);
                return date.toLocaleDateString('de-DE');
            }

            function loadInvoices() {
                API('/admin/invoices?limit=250')
                    .then(function (d) {
                        renderInvoicesTable(d.invoices || []);
                    })
                    .catch(function (e) {
                        showError(
                            'Rechnungen konnten nicht geladen werden: ' + (e.message || String(e))
                        );
                    });
            }

            function renderInvoicesTable(data) {
                invoices = data;
                invoicesFiltered = data;
                var el = document.getElementById('inv-table');
                if (!data || data.length === 0) {
                    el.innerHTML =
                        '<div class="empty-state" style="padding: var(--space-12);">' +
                        '<i data-lucide="receipt" style="width:40px;height:40px;color:var(--text3);margin-bottom: var(--space-4);"></i>' +
                        '<h3 style="color:var(--text);margin-bottom: var(--space-2);">Noch keine Rechnungen</h3>' +
                        '<p style="color:var(--text2);font-size: var(--text-sm);max-width:32ch;text-align:center;">Erstelle deine erste Rechnungen, um die Rechnungsverwaltung zu starten.</p>' +
                        '<button class="btn btn-primary btn-sm" style="margin-top: var(--space-4);" onclick="openNewInvoiceModal()">+ Erste Rechnung erstellen</button>' +
                        '</div>';
                    if (window.lucide) window.lucide.createIcons();
                    return;
                }
                var html =
                    '<table class="data-table"><thead><tr>' +
                    '<th>Rechnungsnr.</th><th>Kunde</th><th>Betrag</th><th>Fälligkeitsdatum</th><th>Status</th><th>Aktionen</th>' +
                    '</tr></thead><tbody>';

                var statusLabels = {
                    draft: 'Entwurf',
                    sent: 'Versendet',
                    paid: 'Bezahlt',
                    overdue: 'Überfällig',
                    cancelled: 'Storniert',
                };

                data.forEach(function (inv) {
                    var statusText = statusLabels[inv.status] || inv.status;
                    var customerDisplay =
                        esc(inv.customer_name || '') +
                        (inv.customer_company
                            ? ' <span style="font-size: var(--text-xs);color:var(--text2);">(' +
                              esc(inv.customer_company) +
                              ')</span>'
                            : '');

                    var actionsHtml =
                        '<button class="btn btn-ghost btn-xs" onclick="viewInvoiceDetail(\'' +
                        inv.id +
                        '\')" style="margin-right: var(--space-1);"><i data-lucide="info" style="width:12px;height:12px;display:inline-block;vertical-align:middle;margin-right: 2px;"></i> Details</button>';

                    if (inv.status === 'draft') {
                        actionsHtml +=
                            '<button class="btn btn-ghost btn-xs text-primary" onclick="sendInvoice(\'' +
                            inv.id +
                            '\')" style="margin-right: var(--space-1);" title="Rechnung senden"><i data-lucide="send" style="width:12px;height:12px;"></i></button>';
                        actionsHtml +=
                            '<button class="btn btn-ghost btn-xs text-danger" onclick="deleteInvoice(\'' +
                            inv.id +
                            '\')" title="Rechnung löschen"><i data-lucide="trash-2" style="width:12px;height:12px;"></i></button>';
                    } else {
                        if (inv.status === 'sent' || inv.status === 'overdue') {
                            actionsHtml +=
                                '<button class="btn btn-ghost btn-xs text-success" onclick="markInvoicePaid(\'' +
                                inv.id +
                                '\')" style="margin-right: var(--space-1);" title="Als bezahlt markieren"><i data-lucide="check-circle" style="width:12px;height:12px;"></i></button>';
                        }
                        if (inv.status !== 'cancelled') {
                            actionsHtml +=
                                '<button class="btn btn-ghost btn-xs" onclick="resendInvoice(\'' +
                                inv.id +
                                '\')" style="margin-right: var(--space-1);" title="Erneut senden"><i data-lucide="mail" style="width:12px;height:12px;"></i></button>';
                        }
                        actionsHtml +=
                            '<button class="btn btn-ghost btn-xs" onclick="downloadInvoicePDF(\'' +
                            inv.id +
                            "', '" +
                            (inv.invoice_number || '') +
                            '\')" title="PDF herunterladen"><i data-lucide="download" style="width:12px;height:12px;"></i></button>';
                    }

                    html +=
                        '<tr><td><code>' +
                        esc(inv.invoice_number || '–') +
                        '</code></td>' +
                        '<td>' +
                        customerDisplay +
                        '</td>' +
                        '<td>' +
                        (inv.amount_gross ? parseFloat(inv.amount_gross).toFixed(2) + ' €' : '–') +
                        '</td>' +
                        '<td>' +
                        fmtDateOnly(inv.due_date) +
                        '</td>' +
                        '<td><span class="badge badge-' +
                        (inv.status || 'draft') +
                        '">' +
                        esc(statusText) +
                        '</span></td>' +
                        '<td><div style="display:flex;align-items:center;">' +
                        actionsHtml +
                        '</div></td>' +
                        '</tr>';
                });
                html += '</tbody></table>';
                el.innerHTML = html;
                if (window.lucide) window.lucide.createIcons();
            }

            function filterInvoices() {
                var search = (document.getElementById('inv-search').value || '').toLowerCase();
                var status = document.getElementById('inv-status-filter').value;
                var filtered = invoicesFiltered.filter(function (inv) {
                    var matchSearch =
                        !search ||
                        (inv.customer_name || '').toLowerCase().includes(search) ||
                        (inv.invoice_number || '').toLowerCase().includes(search);
                    var matchStatus = !status || inv.status === status;
                    return matchSearch && matchStatus;
                });
                renderInvoicesTable(filtered);
            }

            var _niCustomerMap = {};
            var _niFoundLicenses = [];

            function openNewInvoiceModal() {
                API('/admin/customers?limit=1000')
                    .then(function (d) {
                        var customers = d.customers || [];
                        _niCustomerMap = {};
                        _niFoundLicenses = [];
                        var html = '<option value="">-- Kunde auswählen --</option>';
                        customers.forEach(function (c) {
                            _niCustomerMap[c.id] = c;
                            var displayName = c.name + (c.company ? ' (' + c.company + ')' : '');
                            html +=
                                '<option value="' +
                                esc(c.id) +
                                '">' +
                                esc(displayName) +
                                '</option>';
                        });
                        document.getElementById('ni-customer-id').innerHTML = html;
                        document.getElementById('ni-licenses-group').style.display = 'none';
                        document.getElementById('ni-no-license-group').style.display = 'none';
                        document.getElementById('ni-licenses-list').innerHTML = '';
                        document.getElementById('ni-license-key-manual').value = '';
                        document.getElementById('ni-amount').value = '';
                        document.getElementById('ni-due-days').value = '31';
                        document.getElementById('ni-status').value = 'draft';
                        document.getElementById('ni-note').value = '';
                        openModal('modal-new-invoice');
                    })
                    .catch(function (e) {
                        showError(
                            'Kunden konnten nicht geladen werden: ' + (e.message || String(e))
                        );
                    });
            }

            function onInvoiceCustomerChange() {
                var customerId = document.getElementById('ni-customer-id').value;
                var licensesGroup = document.getElementById('ni-licenses-group');
                var noLicenseGroup = document.getElementById('ni-no-license-group');
                var licensesList = document.getElementById('ni-licenses-list');

                licensesGroup.style.display = 'none';
                noLicenseGroup.style.display = 'none';
                _niFoundLicenses = [];

                if (!customerId) return;

                licensesList.innerHTML =
                    '<div style="padding: var(--space-2) var(--space-3);color:var(--text2);font-size: var(--text-sm);">Lädt…</div>';
                licensesGroup.style.display = '';

                var customer = _niCustomerMap[customerId] || {};

                API('/admin/licenses?customer_id=' + encodeURIComponent(customerId) + '&limit=200')
                    .then(function (d) {
                        var licenses = d.licenses || [];
                        if (licenses.length > 0) return licenses;
                        // Fallback: Namenssuche wenn keine customer_id-Verknüpfung vorhanden
                        if (!customer.name) return [];
                        return API(
                            '/admin/licenses?search=' +
                                encodeURIComponent(customer.name) +
                                '&limit=200'
                        ).then(function (d2) {
                            return d2.licenses || [];
                        });
                    })
                    .then(function (licenses) {
                        _niFoundLicenses = licenses;
                        if (licenses.length === 0) {
                            licensesGroup.style.display = 'none';
                            noLicenseGroup.style.display = '';
                            return;
                        }
                        var html = licenses
                            .map(function (l) {
                                var autoCheck = licenses.length === 1 ? ' checked' : '';
                                var domain = l.associated_domain
                                    ? ' – <span style="color:var(--text2)">' +
                                      esc(l.associated_domain) +
                                      '</span>'
                                    : '';
                                var badge =
                                    '<span style="font-size: var(--text-xs);background:var(--bg3);border-radius: var(--radius-sm);padding: 1px var(--space-1);margin-left: var(--space-1);">' +
                                    esc(l.type) +
                                    '</span>';
                                return (
                                    '<label style="display:flex;align-items:center;gap:8px;padding: var(--space-2) var(--space-3);cursor:pointer;" ' +
                                    'onmouseover="this.style.background=\'var(--hover)\'" onmouseout="this.style.background=\'\'">' +
                                    '<input type="checkbox" value="' +
                                    esc(l.license_key) +
                                    '" class="ni-lic-cb"' +
                                    autoCheck +
                                    ' style="accent-color:var(--primary);width:15px;height:15px;flex-shrink:0;">' +
                                    '<span style="font-size: var(--text-sm);font-family:var(--font-mono);">' +
                                    esc(l.license_key) +
                                    domain +
                                    badge +
                                    '</span>' +
                                    '</label>'
                                );
                            })
                            .join('');
                        licensesList.innerHTML = html;
                        licensesGroup.style.display = '';
                        noLicenseGroup.style.display = 'none';
                    })
                    .catch(function () {
                        licensesGroup.style.display = 'none';
                        noLicenseGroup.style.display = '';
                    });
            }

            function saveInvoice() {
                var customer_id = document.getElementById('ni-customer-id').value;
                var amount = parseFloat(document.getElementById('ni-amount').value);
                var dueDays = parseInt(document.getElementById('ni-due-days').value) || 31;
                var dueDate = new Date();
                dueDate.setDate(dueDate.getDate() + dueDays);
                var due_date = dueDate.toISOString().slice(0, 10);
                var status = document.getElementById('ni-status').value;
                var note = document.getElementById('ni-note').value || null;

                if (!customer_id || isNaN(amount) || amount <= 0) {
                    toast('Bitte Kunde und Betrag angeben.', 'error');
                    return;
                }

                // Ausgewählte Lizenzen (Checkboxen)
                var checkedBoxes = Array.from(document.querySelectorAll('.ni-lic-cb:checked'));
                var selectedKeys = checkedBoxes.map(function (cb) {
                    return cb.value;
                });

                // Manuelles Fallback-Feld
                if (selectedKeys.length === 0) {
                    var manualKey = document.getElementById('ni-license-key-manual').value.trim();
                    if (manualKey) selectedKeys = [manualKey];
                }

                var items;
                if (selectedKeys.length === 0) {
                    items = [
                        { description: note || 'Lizenzgebühr', quantity: 1, unit_price: amount },
                    ];
                } else {
                    items = selectedKeys.map(function (key) {
                        var lic = _niFoundLicenses.find(function (l) {
                            return l.license_key === key;
                        });
                        var desc = 'Lizenzgebühr';
                        if (lic) {
                            desc = 'Lizenzgebühr ' + (lic.type || 'Lizenz');
                            if (lic.associated_domain) desc += ' – ' + lic.associated_domain;
                        } else if (key) {
                            desc = 'Lizenzgebühr – ' + key;
                        }
                        if (note) desc += ' (' + note + ')';
                        return { description: desc, quantity: 1, unit_price: amount };
                    });
                }

                // Primärer Lizenz-Key für die Rechnung (nur wenn genau eine gewählt)
                var license_key = selectedKeys.length === 1 ? selectedKeys[0] : null;

                var body = {
                    customer_id: customer_id,
                    license_key: license_key,
                    items: items,
                    due_date: due_date,
                    notes: note,
                    type: 'invoice',
                };

                API('/admin/invoices', {
                    method: 'POST',
                    body: JSON.stringify(body),
                })
                    .then(function (newInvoice) {
                        closeModal('modal-new-invoice');

                        if (status === 'sent') {
                            sendInvoice(newInvoice.id);
                        } else if (status === 'paid') {
                            API('/admin/invoices/' + newInvoice.id + '/send', { method: 'POST' })
                                .then(function () {
                                    markInvoicePaid(newInvoice.id);
                                })
                                .catch(function () {
                                    markInvoicePaid(newInvoice.id);
                                });
                        } else {
                            loadInvoices();
                        }
                    })
                    .catch(function (e) {
                        showError(
                            'Fehler beim Erstellen der Rechnung: ' + (e.message || String(e))
                        );
                    });
            }

            function viewInvoiceDetail(id) {
                API('/admin/invoices/' + id)
                    .then(function (inv) {
                        var statusLabels = {
                            draft: 'Entwurf',
                            sent: 'Versendet',
                            paid: 'Bezahlt',
                            overdue: 'Überfällig',
                            cancelled: 'Storniert',
                        };

                        var html =
                            '<div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; margin-bottom: var(--space-6); text-align: left;">' +
                            '<div>' +
                            '<h4 style="margin-bottom: var(--space-2);color:var(--text2);text-transform:uppercase;font-size: var(--text-xs);letter-spacing: 0.08em;">Empfänger</h4>' +
                            '<p style="font-weight: 500;margin: 0;">' +
                            esc(inv.customer_name || '–') +
                            '</p>' +
                            (inv.customer_company
                                ? '<p style="margin: 0;color:var(--text2);">' +
                                  esc(inv.customer_company) +
                                  '</p>'
                                : '') +
                            '<p style="margin: 0;color:var(--text2);">' +
                            esc(inv.customer_billing_street || '–') +
                            '</p>' +
                            '<p style="margin: 0;color:var(--text2);">' +
                            esc(inv.customer_billing_zip || '') +
                            ' ' +
                            esc(inv.customer_billing_city || '') +
                            '</p>' +
                            '<p style="margin: 0;color:var(--text2);">' +
                            esc(inv.customer_billing_country || '') +
                            '</p>' +
                            (inv.customer_email
                                ? '<p style="margin: var(--space-2) 0 0 0;font-size: var(--text-sm);color:var(--primary);">' +
                                  esc(inv.customer_email) +
                                  '</p>'
                                : '') +
                            '</div>' +
                            '<div>' +
                            '<h4 style="margin-bottom: var(--space-2);color:var(--text2);text-transform:uppercase;font-size: var(--text-xs);letter-spacing: 0.08em;">Details</h4>' +
                            '<p style="margin: 0;"><span style="color:var(--text2)">Rechnungsnummer:</span> <strong>' +
                            esc(inv.invoice_number || '–') +
                            '</strong></p>' +
                            '<p style="margin: 0;"><span style="color:var(--text2)">Status:</span> <span class="badge badge-' +
                            inv.status +
                            '">' +
                            esc(statusLabels[inv.status] || inv.status) +
                            '</span></p>' +
                            '<p style="margin: 0;"><span style="color:var(--text2)">Datum:</span> ' +
                            fmtDateOnly(inv.created_at) +
                            '</p>' +
                            '<p style="margin: 0;"><span style="color:var(--text2)">Fällig am:</span> ' +
                            fmtDateOnly(inv.due_date) +
                            '</p>' +
                            (inv.paid_at
                                ? '<p style="margin: 0;"><span style="color:var(--text2)">Bezahlt am:</span> ' +
                                  fmtDateOnly(inv.paid_at) +
                                  '</p>'
                                : '') +
                            (inv.license_key
                                ? '<p style="margin: var(--space-2) 0 0 0;font-size: var(--text-sm);"><span style="color:var(--text2)">Lizenz-Key:</span> <code>' +
                                  esc(inv.license_key) +
                                  '</code></p>'
                                : '') +
                            '</div>' +
                            '</div>';

                        html +=
                            '<h4 style="margin-bottom: var(--space-2);color:var(--text2);text-transform:uppercase;font-size: var(--text-xs);letter-spacing: 0.08em;text-align: left;">Positionen</h4>' +
                            '<table class="data-table" style="margin-bottom: var(--space-6); width: 100%;">' +
                            '<thead><tr><th>Beschreibung</th><th style="text-align:right;">Menge</th><th style="text-align:right;">Einzelpreis</th><th style="text-align:right;">Gesamt</th></tr></thead>' +
                            '<tbody>';

                        if (inv.items && inv.items.length > 0) {
                            inv.items.forEach(function (item) {
                                html +=
                                    '<tr>' +
                                    '<td>' +
                                    esc(item.description || '–') +
                                    '</td>' +
                                    '<td style="text-align:right;">' +
                                    parseFloat(item.quantity).toFixed(2) +
                                    '</td>' +
                                    '<td style="text-align:right;">' +
                                    parseFloat(item.unit_price).toFixed(2) +
                                    ' €</td>' +
                                    '<td style="text-align:right;">' +
                                    parseFloat(item.total).toFixed(2) +
                                    ' €</td>' +
                                    '</tr>';
                            });
                        } else {
                            html +=
                                '<tr><td colspan="4" style="text-align:center;color:var(--text2);">Keine Positionen vorhanden</td></tr>';
                        }

                        html += '</tbody></table>';

                        html +=
                            '<div style="display:flex; justify-content:flex-end; margin-bottom: var(--space-6);">' +
                            '<div style="width:250px; display:grid; grid-template-columns:1fr 1fr; gap:.5rem; font-size: var(--text-sm); text-align: left;">' +
                            '<div style="color:var(--text2)">Netto-Summe:</div><div style="text-align:right;">' +
                            parseFloat(inv.amount_net || 0).toFixed(2) +
                            ' €</div>' +
                            '<div style="color:var(--text2)">MwSt. (' +
                            parseFloat(inv.tax_rate || 0) +
                            '%):</div><div style="text-align:right;">' +
                            parseFloat(inv.amount_tax || 0).toFixed(2) +
                            ' €</div>' +
                            '<div style="font-weight:bold; border-top:1px solid var(--border); padding-top: var(--space-2); margin-top: var(--space-1);">Brutto-Summe:</div>' +
                            '<div style="font-weight:bold; border-top:1px solid var(--border); padding-top: var(--space-2); margin-top: var(--space-1); text-align:right;">' +
                            parseFloat(inv.amount_gross || 0).toFixed(2) +
                            ' €</div>' +
                            '</div>' +
                            '</div>';

                        if (inv.notes) {
                            html +=
                                '<div style="background:var(--bg3); padding: var(--space-4); border-radius: var(--radius-md); font-size: var(--text-sm); color:var(--text2); margin-bottom: var(--space-6); text-align: left;">' +
                                '<strong>Notiz:</strong> ' +
                                esc(inv.notes) +
                                '</div>';
                        }

                        var actionsHtml =
                            '<div style="display:flex; gap:.5rem; justify-content:flex-start; border-top: 1px solid var(--border); padding-top: var(--space-4);">';

                        if (inv.status === 'draft') {
                            actionsHtml +=
                                '<button class="btn btn-primary btn-sm" onclick="sendInvoice(\'' +
                                inv.id +
                                '\'); closeModal(\'modal-view-invoice\');"><i data-lucide="send" style="width:14px;height:14px;margin-right: var(--space-1);vertical-align:middle;"></i> Versenden</button>';
                            actionsHtml +=
                                '<button class="btn btn-danger btn-sm" onclick="deleteInvoice(\'' +
                                inv.id +
                                '\'); closeModal(\'modal-view-invoice\');"><i data-lucide="trash-2" style="width:14px;height:14px;margin-right: var(--space-1);vertical-align:middle;"></i> Löschen</button>';
                        } else {
                            if (inv.status !== 'cancelled') {
                                actionsHtml +=
                                    '<button class="btn btn-ghost btn-sm" onclick="resendInvoice(\'' +
                                    inv.id +
                                    '\')"><i data-lucide="mail" style="width:14px;height:14px;margin-right: var(--space-1);vertical-align:middle;"></i> Erneut senden</button>';
                            }
                            if (inv.status === 'sent' || inv.status === 'overdue') {
                                actionsHtml +=
                                    '<button class="btn btn-success btn-sm" onclick="markInvoicePaid(\'' +
                                    inv.id +
                                    '\'); closeModal(\'modal-view-invoice\');"><i data-lucide="check-circle" style="width:14px;height:14px;margin-right: var(--space-1);vertical-align:middle;"></i> Als bezahlt markieren</button>';
                            }
                            actionsHtml +=
                                '<button class="btn btn-ghost btn-sm" onclick="downloadInvoicePDF(\'' +
                                inv.id +
                                "', '" +
                                (inv.invoice_number || '') +
                                '\')"><i data-lucide="download" style="width:14px;height:14px;margin-right: var(--space-1);vertical-align:middle;"></i> PDF</button>';
                        }

                        actionsHtml += '</div>';

                        document.getElementById('modal-view-invoice-content').innerHTML =
                            html + actionsHtml;
                        openModal('modal-view-invoice');
                        if (window.lucide) window.lucide.createIcons();
                    })
                    .catch(function (e) {
                        showError(
                            'Rechnungsdetails konnten nicht geladen werden: ' +
                                (e.message || String(e))
                        );
                    });
            }

            function downloadInvoicePDF(id, invoiceNumber) {
                var url = '/api/admin/invoices/' + id + '/pdf';
                fetch(url, { headers: { Authorization: 'Bearer ' + TOKEN } })
                    .then(function (r) {
                        if (!r.ok) throw new Error('PDF konnte nicht heruntergeladen werden.');
                        return r.blob();
                    })
                    .then(function (blob) {
                        var fileUrl = window.URL.createObjectURL(blob);
                        var a = document.createElement('a');
                        a.href = fileUrl;
                        a.download = 'Rechnung-' + (invoiceNumber || id) + '.pdf';
                        document.body.appendChild(a);
                        a.click();
                        a.remove();
                    })
                    .catch(function (e) {
                        showError(e.message || String(e));
                    });
            }

            function sendInvoice(id) {
                API('/admin/invoices/' + id + '/send', { method: 'POST' })
                    .then(function (d) {
                        if (d && d.mail_error) {
                            showError(
                                'Rechnung als gesendet markiert, aber E-Mail fehlgeschlagen:\n' +
                                    d.mail_error +
                                    '\n\nBitte SMTP-Einstellungen unter ⚙ prüfen.'
                            );
                        }
                        loadInvoices();
                    })
                    .catch(function (e) {
                        showError('Fehler beim Senden der Rechnung: ' + (e.message || String(e)));
                    });
            }

            function resendInvoice(id) {
                API('/admin/invoices/' + id + '/resend', { method: 'POST' })
                    .then(function (d) {
                        if (d && d.mail_error) {
                            showError(
                                'Rechnung als gesendet markiert, aber E-Mail fehlgeschlagen:\n' +
                                    d.mail_error +
                                    '\n\nBitte SMTP-Einstellungen unter ⚙ prüfen.'
                            );
                        } else {
                            toast('Rechnung erfolgreich gesendet.', 'success');
                        }
                        loadInvoices();
                    })
                    .catch(function (e) {
                        showError('Fehler beim Senden der Rechnung: ' + (e.message || String(e)));
                    });
            }

            function markInvoicePaid(id) {
                API('/admin/invoices/' + id + '/mark-paid', { method: 'POST' })
                    .then(function () {
                        loadInvoices();
                    })
                    .catch(function (e) {
                        showError('Fehler beim Markieren als bezahlt: ' + (e.message || String(e)));
                    });
            }

            function deleteInvoice(id) {
                showConfirm('Rechnung unwiderruflich löschen?', function () {
                    API('/admin/invoices/' + id, { method: 'DELETE' })
                        .then(function () {
                            loadInvoices();
                        })
                        .catch(function (e) {
                            showError(
                                'Fehler beim Löschen der Rechnung: ' + (e.message || String(e))
                            );
