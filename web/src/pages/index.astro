            var PLANS_CACHE = null;
            function loadPlanInfo(type) {
                if (!type) return;
                var el = document.getElementById('nl-plan-info');
                if (!el) return;
                function render(plans) {
                    var p = plans[type];
                    if (!p) {
                        el.innerHTML = '';
                        return;
                    }
                    el.innerHTML =
                        '<i data-lucide="package" style="width:1em;height:1em;vertical-align:-0.15em;margin-right:0.35em;"></i>' +
                        esc(p.label || type) +
                        ' &mdash; ' +
                        (p.menu_items || '?') +
                        ' Gerichte, ' +
                        (p.max_tables || '?') +
                        ' Tische, ' +
                        (p.expires_days || '?') +
                        ' Tage Laufzeit';
                    if (window.lucide) window.lucide.createIcons();
                }
                if (PLANS_CACHE) {
                    render(PLANS_CACHE);
                    return;
                }
                API('/admin/plans')
                    .then(function (d) {
                        PLANS_CACHE = d;
                        render(d);
                    })
                    .catch(function () {});
            }

            // Event listener safely attached (will be attached after DOM is ready)
