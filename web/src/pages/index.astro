                width: 36px;
                height: 20px;
                flex-shrink: 0;
            }
            .switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }
            .slider {
                position: absolute;
                cursor: pointer;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background-color: var(--bg);
                transition: 0.3s;
                border-radius: var(--radius-xl);
                border: 1px solid var(--border);
