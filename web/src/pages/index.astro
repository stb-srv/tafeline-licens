                            '<button class="btn btn-primary" onclick="saveSmtp()">Speichern &amp; Verbindung prüfen</button>' +
                            '</div>' +
                            (s.configured
                                ? '<div style="margin-top: var(--space-4);padding-top: var(--space-4);border-top:1px solid var(--border)">' +
                                  '<p style="font-size: var(--text-sm);color:var(--text2);margin-bottom: var(--space-2)">Test-E-Mail senden:</p>' +
                                  '<div style="display:flex;gap:.6rem;align-items:center;flex-wrap:wrap">' +
                                  '<input type="email" id="smtp-test-to" placeholder="empfaenger@mail.de" style="background:var(--bg2);border:1px solid var(--border);border-radius: var(--radius-md);padding: var(--space-2) var(--space-3);color:var(--text);font-size: var(--text-sm);outline:none;min-width:220px">' +
                                  '<button class="btn btn-ghost" onclick="testSmtp()">Test senden</button>' +
