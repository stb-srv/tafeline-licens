            function openAdmin() {
                function hide(id) {
                    var el = document.getElementById(id);
                    if (el) el.style.display = 'none';
                }
                hide('public-pages');
                hide('main-footer');
                hide('main-nav');
                hide('cookie-banner');
                document.getElementById('page-admin').classList.add('active');
                if (TOKEN) {
                    // Token kurz gegen den Server prüfen – bei 401 wird API() auto-logout
                    API('/admin/licenses?limit=1')
                        .then(function () {
                            showDashboard();
                        })
                        .catch(function () {
                            // Falls Token abgelaufen: API() hat bereits ausgeloggt → showLogin()
                            showLogin();
                        });
                } else {
                    showLogin();
                }
            }
            function closeAdmin() {
                document.getElementById('public-pages').style.display = '';
                document.getElementById('main-footer').style.display = '';
                document.getElementById('main-nav').style.display = '';
                document.getElementById('page-admin').classList.remove('active');
                if (!localStorage.getItem('cookie_consent')) {
                    document.getElementById('cookie-banner').style.display = 'flex';
                }
            }
            function showLogin(msg) {
                document.getElementById('admin-login').style.display = 'flex';
                document.getElementById('admin-dashboard').style.display = 'none';
                if (msg) {
                    document.getElementById('login-alert').innerHTML =
                        '<div class="alert alert-info">&#9888;&#65039; ' + esc(msg) + '</div>';
                } else {
                    document.getElementById('login-alert').innerHTML = '';
                }
            }
            function showDashboard() {
                document.getElementById('admin-login').style.display = 'none';
                document.getElementById('admin-dashboard').style.display = 'flex';
                document.getElementById('sb-user').textContent = USER + ' (' + ROLE + ')';
                switchTab('overview');
            }

            var TEMP_2FA_TOKEN = '';

            function doLogin() {
                var username = document.getElementById('login-user').value.trim();
                var password = document.getElementById('login-pass').value;
                if (!username || !password) {
                    showAlert('login-alert', 'Benutzername und Passwort eingeben.');
                    return;
                }
                API('/admin/login', {
                    method: 'POST',
                    body: JSON.stringify({ username: username, password: password }),
                })
                    .then(function (d) {
                        if (d.two_factor_required) {
                            TEMP_2FA_TOKEN = d.temp_token;
                            document.getElementById('login-form-step').style.display = 'none';
                            document.getElementById('2fa-form-step').style.display = 'block';
                            document.getElementById('login-back-btn').style.display = 'none';
                            document.getElementById('login-alert').innerHTML = '';
                            return;
                        }
                        TOKEN = d.token;
                        ROLE = d.role;
                        USER = d.username;
                        sessionStorage.setItem('admin_token', TOKEN);
                        sessionStorage.setItem('admin_role', ROLE);
                        sessionStorage.setItem('admin_user', USER);
                        document.getElementById('login-pass').value = '';
                        showDashboard();
                    })
                    .catch(function (e) {
                        var msg = e.message || 'Login fehlgeschlagen.';
                        if (msg === 'Invalid credentials')
                            msg = 'Benutzername oder Passwort falsch.';
                        showAlert('login-alert', esc(msg));
                    });
            }

            function doVerify2FA() {
                var code = document.getElementById('login-2fa-code').value.trim();
                if (!code) {
                    showAlert('login-alert', 'Bitte Code eingeben.');
                    return;
                }
                API('/admin/login/2fa', {
                    method: 'POST',
                    body: JSON.stringify({ code: code, temp_token: TEMP_2FA_TOKEN }),
                })
                    .then(function (d) {
                        TOKEN = d.token;
                        ROLE = d.role;
                        USER = d.username;
                        sessionStorage.setItem('admin_token', TOKEN);
                        sessionStorage.setItem('admin_role', ROLE);
                        sessionStorage.setItem('admin_user', USER);
                        resetLogin();
                        showDashboard();
                    })
                    .catch(function (e) {
                        showAlert('login-alert', esc(e.message || 'Ungültiger Code.'));
                    });
            }

            function resetLogin() {
                document.getElementById('login-form-step').style.display = 'block';
                document.getElementById('2fa-form-step').style.display = 'none';
                document.getElementById('login-back-btn').style.display = 'inline-flex';
                document.getElementById('login-2fa-code').value = '';
                TEMP_2FA_TOKEN = '';
            }

            function setup2FA() {
                API('/admin/2fa/setup', { method: 'POST' })
                    .then(function (d) {
                        document.getElementById('2fa-qr-img').src = d.qr_code;
                        document.getElementById('2fa-verify-code').value = '';
                        document.getElementById('2fa-alert').innerHTML = '';
                        openModal('modal-2fa-setup');
                    })
                    .catch(function (e) {
                        showError(e.message || String(e));
                    });
            }

            function verify2FASetup() {
                var code = document.getElementById('2fa-verify-code').value.trim();
                if (!code) return showAlert('2fa-alert', 'Code eingeben.');
                API('/admin/2fa/verify', { method: 'POST', body: JSON.stringify({ code: code }) })
                    .then(function (d) {
                        showError('2FA erfolgreich aktiviert!', 'Erfolg');
                        closeModal('modal-2fa-setup');
                        loadUsers();
                    })
                    .catch(function (e) {
                        showAlert('2fa-alert', esc(e.message || 'Fehler.'));
                    });
            }

            function disable2FA() {
                showConfirm('Möchtest du 2FA wirklich deaktivieren?', function () {
                    API('/admin/2fa/disable', { method: 'POST' })
                        .then(function () {
                            showError('2FA wurde deaktiviert.', 'Information');
                            loadUsers();
                        })
                        .catch(function (e) {
                            showError(e.message || String(e));
                        });
                });
            }
            function doLogout() {
                TOKEN = '';
                ROLE = '';
                USER = '';
                sessionStorage.removeItem('admin_token');
                sessionStorage.removeItem('admin_role');
                sessionStorage.removeItem('admin_user');
                showLogin();
            }
            document.addEventListener('keydown', function (e) {
                if (
                    e.key === 'Enter' &&
                    document.getElementById('admin-login').style.display !== 'none'
                )
                    doLogin();
            });

            function switchTab(name) {
                document.querySelectorAll('#admin-dashboard .tab-panel').forEach(function (p) {
                    p.classList.remove('active');
                });
                document.querySelectorAll('.sidebar-menu li a').forEach(function (a) {
                    a.classList.remove('active');
                });
                var tp = document.getElementById('tab-' + name);
                if (tp) tp.classList.add('active');
                var tb = document.getElementById('tab-btn-' + name);
                if (tb) tb.classList.add('active');
                var loaders = {
                    overview: loadOverview,
                    licenses: loadLicenses,
                    customers: loadCustomers,
                    invoices: loadInvoices,
                    devices: loadDevices,
                    logs: function () {
                        switchSubTab(activeSubTab);
                    },
                    users: loadUsers,
                    smtp: loadSmtp,
                    webhooks: loadWebhooks,
                    plans: loadAdminPlans,
                    faq: loadAdminFaq,
                };
                if (loaders[name]) loaders[name]();
            }

            function switchSubTab(name) {
                activeSubTab = name;
                document.querySelectorAll('.subtab-panel').forEach(function (p) {
                    p.classList.remove('active');
                });
                document.querySelectorAll('.subtab-btn').forEach(function (b) {
                    b.classList.remove('active');
                });
                var sp = document.getElementById('subtab-' + name);
                if (sp) sp.classList.add('active');
                var sb = document.getElementById('stab-btn-' + name);
                if (sb) sb.classList.add('active');
                if (name === 'login-log') loadLoginLog();
                else if (name === 'audit-log') loadAudit();
                else if (name === 'purchase-history') loadPurchaseHistory();
            }
            function reloadActiveLogs() {
                switchSubTab(activeSubTab);
            }

            function resetNewLicenseModal() {
                document.getElementById('nl-customer-id').value = '';
                document.getElementById('nl-name').value = '';
                document.getElementById('nl-domain').value = '';
                document.getElementById('nl-tags').value = '';
                document.getElementById('nl-devices').value = '0';
                document.getElementById('nl-expires').value = '';
                var infoEl = document.getElementById('nl-customer-info');
                if (infoEl) infoEl.style.display = 'none';
            }

            function openModal(id) {
                var m = document.getElementById(id);
                if (m) m.classList.add('open');
            }
            function closeModal(id) {
                var m = document.getElementById(id);
                if (m) m.classList.remove('open');
                if (id === 'modal-new-license') resetNewLicenseModal();
            }
            document.querySelectorAll('.modal-overlay').forEach(function (m) {
                m.addEventListener('click', function (e) {
                    if (e.target === m) closeModal(m.id);
                });
            });

            function typeBadge(t) {
                var map = {
                    FREE: 'badge-free',
                    BASIC: 'badge-active',
                    PRO: 'badge-pro',
                    ENTERPRISE: 'badge-enterprise',
                };
                return '<span class="badge ' + (map[t] || '') + '">' + esc(t) + '</span>';
            }
            function statusBadge(s) {
                return '<span class="badge badge-' + esc(s) + '">' + esc(s) + '</span>';
            }
            function tagsBadges(tags) {
                if (!tags) return '';
                try {
                    var arr = safeParse(tags, []);
                    return arr
                        .map(function (t) {
                            return '<span class="tag-pill">' + esc(t) + '</span>';
                        })
                        .join('');
                } catch (e) {
                    return '';
                }
            }

            var overviewPeriod = 30;
            function setPeriod(p) {
                overviewPeriod = p;
                document.querySelectorAll('.period-pill').forEach(function (btn) {
                    btn.classList.toggle('active', Number(btn.dataset.period) === p);
                });
                loadOverview();
            }

            function loadOverview() {
                document.getElementById('stats-row').innerHTML = skeletonTable(6, 1);
                API('/admin/licenses?limit=10')
                    .then(function (lic) {
                        return API('/admin/analytics?period=' + overviewPeriod).then(function (ana) {
                            var s = lic.stats || {};
                            var rev = ana.revenue || { total: 0, last_period: 0 };
                            var valTotal = (ana.validations_per_day || []).reduce(function (a, b) {
                                return a + b.count;
                            }, 0);
                            var periodLabel = overviewPeriod === 365 ? '12M' : overviewPeriod + 'T';

                            var gp = ana.growth.last_period || 0;
                            var g7 = ana.growth.last_7d || 0;
                            document.getElementById('stats-row').innerHTML =
                                '<div class="stat-card"><div class="stat-label"><i data-lucide="key-round"></i> Gesamt Lizenzen</div><div class="stat-value">' +
                                (s.total || 0) +
                                '</div><div class="stat-trend' + (gp >= 0 ? '' : ' down') + '"><i data-lucide="' + (gp >= 0 ? 'trending-up' : 'trending-down') + '"></i> ' + (gp >= 0 ? '+' : '') +
                                gp +
                                ' in ' + periodLabel + '</div></div>' +
                                '<div class="stat-card"><div class="stat-label"><i data-lucide="check-circle-2"></i> Aktive Lizenzen</div><div class="stat-value" style="color:var(--success)">' +
                                (s.active || 0) +
                                '</div></div>' +
                                '<div class="stat-card"><div class="stat-label"><i data-lucide="shield-check"></i> Validierungen (' + periodLabel + ')</div><div class="stat-value">' +
                                valTotal +
                                '</div></div>' +
                                '<div class="stat-card"><div class="stat-label"><i data-lucide="banknote"></i> Umsatz (' + periodLabel + ')</div><div class="stat-value" style="color:var(--primary)">' +
                                fmtEur(rev.last_period) +
                                '</div><div class="stat-trend' + (g7 >= 0 ? '' : ' down') + '"><i data-lucide="' + (g7 >= 0 ? 'trending-up' : 'trending-down') + '"></i> ' + (g7 >= 0 ? '+' : '') +
                                g7 +
                                ' neue (7d)</div></div>' +
                                '<div class="stat-card"><div class="stat-label"><i data-lucide="wallet"></i> Umsatz (Gesamt)</div><div class="stat-value" style="color:var(--warning)">' +
                                fmtEur(rev.total) +
                                '</div></div>' +
                                '<div class="stat-card"><div class="stat-label"><i data-lucide="monitor"></i> Geräte</div><div class="stat-value">' +
                                ana.devices.total +
                                '</div><div class="stat-trend"><i data-lucide="activity"></i> ' +
                                ana.devices.active +
                                ' aktiv</div></div>';
                            if (window.lucide) window.lucide.createIcons();

                            var top = ana.top_licenses || [];
                            document.getElementById('top-licenses').innerHTML = top.length
                                ? '<table class="data-table"><thead><tr><th>Lizenz-Key</th><th>Kunde</th><th>Typ</th><th>Validierungen</th><th>Zuletzt</th></tr></thead><tbody>' +
                                  top
                                      .map(function (l) {
                                          return (
                                              '<tr><td><code>' +
                                              esc((l.license_key || '').slice(0, 18)) +
                                              '&hellip;</code></td><td>' +
                                              esc(l.customer_name || '\u2014') +
                                              '</td><td>' +
                                              typeBadge(l.type) +
                                              '</td><td>' +
                                              (l.usage_count || 0) +
                                              '</td><td>' +
                                              fmtDate(l.last_validated) +
                                              '</td></tr>'
                                          );
                                      })
                                      .join('') +
                                  '</tbody></table>'
                                : '<div class="loading">Keine Daten</div>';

                            renderCharts(ana);

                            return API('/admin/licenses?expiring=1&limit=20').then(function (exp) {
                                var list = exp.licenses || [];
                                document.getElementById('expiring-licenses').innerHTML = list.length
                                    ? '<table class="data-table"><thead><tr><th>Key</th><th>Kunde</th><th>Typ</th><th>Ablaufdatum</th><th>Tage</th><th>Aktionen</th></tr></thead><tbody>' +
                                      list
                                          .map(function (l) {
                                              var d = daysLeft(l.expires_at);
                                              return (
                                                  '<tr><td><code>' +
                                                  esc((l.license_key || '').slice(0, 12)) +
                                                  '&hellip;</code></td><td>' +
                                                  esc(l.customer_name || '\u2014') +
                                                  '</td><td>' +
                                                  typeBadge(l.type) +
                                                  '</td><td>' +
                                                  fmtDate(l.expires_at) +
                                                  '</td><td style="color:var(--warning)">noch ' +
                                                  d +
                                                  'd</td><td><button class="btn btn-success btn-xs" onclick="renewLicense(\'' +
                                                  esc(l.license_key) +
                                                  '\')" >Verlängern</button></td></tr>'
                                              );
                                          })
                                          .join('') +
                                      '</tbody></table>'
                                    : '<div class="loading">Aktuell keine ablaufenenden Lizenzen in den nächsten 30 Tagen.</div>';
                            });
                        });
                    })
                    .catch(function (e) {
                        document.getElementById('stats-row').innerHTML =
                            '<div class="alert alert-error">' +
                            esc(e.message || 'Fehler') +
                            '</div>';
                    });
            }

            function loadLicenses(page) {
                if (page !== undefined) licPage = page;
                document.getElementById('lic-table').innerHTML = skeletonTable(7);
                var url =
                    '/admin/licenses?page=' +
                    licPage +
                    '&limit=25' +
                    (licSearch ? '&search=' + encodeURIComponent(licSearch) : '');
                API(url)
                    .then(function (d) {
                        var licenses = d.licenses || [],
                            pg = d.pagination || {};
                        var html = licenses.length
                            ? '<table class="data-table"><thead><tr><th>Key</th><th>Typ</th><th>Kunde</th><th>Tags</th><th>Status</th><th>Läuft ab</th><th>Aktionen</th></tr></thead><tbody>' +
                              licenses
                                  .map(function (l) {
                                      var days = daysLeft(l.expires_at);
                                      var expClass =
                                          days < 0
                                              ? 'color:var(--danger)'
                                              : days < 30
                                                ? 'color:var(--warning)'
                                                : '';
                                      return (
                                          '<tr>' +
                                          '<td><code title="' +
                                          esc(l.license_key) +
                                          '">' +
                                          esc(l.license_key.slice(0, 16)) +
                                          '&hellip;</code></td>' +
                                          '<td>' +
                                          typeBadge(l.type) +
                                          '</td><td>' +
                                          esc(l.customer_name || '\u2014') +
                                          '</td>' +
                                          '<td>' +
                                          tagsBadges(l.tags) +
                                          '</td><td>' +
                                          statusBadge(l.status) +
                                          '</td>' +
                                          '<td style="' +
                                          expClass +
                                          '">' +
                                          fmtDate(l.expires_at) +
                                          '</td>' +
                                          '<td style="white-space:nowrap">' +
                                          '<button class="btn btn-ghost btn-xs" onclick="viewLicense(\'' +
                                          esc(l.license_key) +
                                          '\')" >Details</button> ' +
                                          '<button class="btn btn-success btn-xs" onclick="renewLicense(\'' +
                                          esc(l.license_key) +
                                          '\')" >+365d</button> ' +
                                          '<button class="btn btn-danger btn-xs" onclick="deleteLicense(\'' +
                                          esc(l.license_key) +
                                          '\')" ><i data-lucide="trash-2" style="width:12px;height:12px;"></i></button>' +
                                          '</td></tr>'
                                      );
                                  })
                                  .join('') +
                              '</tbody></table>' +
                              renderPagination(pg, 'loadLicenses')
                            : emptyState('key', 'Keine Lizenzen', 'Erstelle deine erste Lizenz, um loszulegen.', '+ Lizenz erstellen', 'openNewLicenseModal()');
                        document.getElementById('lic-table').innerHTML = html;
                        if (window.lucide) window.lucide.createIcons();
                    })
                    .catch(function (e) {
                        document.getElementById('lic-table').innerHTML =
                            '<div class="alert alert-error" style="margin: var(--space-4)">' +
                            esc(e.message || 'Fehler') +
                            '</div>';
                    });
            }
            function filterLic() {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(function () {
                    licSearch = document.getElementById('lic-search').value;
                    licPage = 1;
                    loadLicenses();
                }, 400);
            }

            function debounceSearch() {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(function () {
                    var val = document.getElementById('lic-search').value.trim();
                    licSearch = val;
                    licPage = 1;
                    loadLicenses();
                }, 300);
            }

            function viewLicense(key) {
                API('/admin/licenses/' + encodeURIComponent(key))
                    .then(function (d) {
                        var l = d.license;
                        var statuses = ['active', 'revoked', 'cancelled', 'expired', 'suspended'];
                        document.getElementById('modal-edit-license-content').innerHTML =
                            '<div class="form-group"><label>Lizenz-Key</label><input readonly value="' +
                            esc(l.license_key) +
                            '"></div>' +
                            '<div class="form-group"><label>Typ</label><input readonly value="' +
                            esc(l.type) +
                            '"></div>' +
                            '<div class="form-group"><label>Kundenname</label><input readonly value="' +
                            esc(l.customer_name || '') +
                            '"></div>' +
                            '<div class="form-group"><label>Domain</label><input readonly value="' +
                            esc(l.associated_domain || '') +
                            '"></div>' +
                            '<div class="form-group"><label>Ablaufdatum</label><input readonly value="' +
                            esc(fmtDate(l.expires_at)) +
                            '"></div>' +
                            '<div class="form-group"><label>Validierungen</label><input readonly value="' +
                            esc(l.usage_count || 0) +
                            '"></div>' +
                            '<div class="form-group"><label>Tags (kommagetrennt)</label><input id="edit-tags" value="' +
                            esc(safeParse(l.tags, []).join(', ')) +
                            '"></div>' +
                            '<div class="form-group"><label>Letzter Check</label><input readonly value="' +
                            esc(fmtDate(l.last_validated)) +
                            '"></div>' +
                            '<div class="form-group"><label>Status ändern</label>' +
                            '<select id="edit-status-sel">' +
                            statuses
                                .map(function (s) {
                                    return (
                                        '<option value="' +
                                        s +
                                        '"' +
                                        (s === l.status ? ' selected' : '') +
                                        '>' +
                                        s +
                                        '</option>'
                                    );
                                })
                                .join('') +
                            '</select>' +
                            '</div>' +
                            '<button class="btn btn-primary btn-sm" onclick="saveStatus(\'' +
                            esc(l.license_key) +
                            '\')" >Status speichern</button>';
                        openModal('modal-edit-license');
                    })
                    .catch(function (e) {
                        showError(e.message || String(e));
                    });
            }
            function saveStatus(key) {
                var status = document.getElementById('edit-status-sel').value;
                API('/admin/licenses/' + encodeURIComponent(key) + '/status', {
                    method: 'PATCH',
                    body: JSON.stringify({ status: status }),
                })
                    .then(function () {
                        closeModal('modal-edit-license');
                        loadLicenses();
                    })
                    .catch(function (e) {
                        showError(e.message || String(e));
                    });
            }
            function renewLicense(key) {
                showConfirm('Lizenz um 365 Tage verlängern?', function () {
                    API('/admin/licenses/' + encodeURIComponent(key) + '/renew', {
                        method: 'POST',
                        body: JSON.stringify({ days: 365 }),
                    })
                        .then(function () {
                            loadLicenses();
                        })
                        .catch(function (e) {
                            showError(e.message || String(e));
                        });
                });
            }
            function deleteLicense(key) {
                showConfirm('Lizenz ' + key + ' unwiderruflich löschen?', function () {
                    API('/admin/licenses/' + encodeURIComponent(key), { method: 'DELETE' })
                        .then(function () {
                            loadLicenses();
                        })
                        .catch(function (e) {
                            showError(e.message || String(e));
                        });
                });
            }
            function createLicense() {
                var body = {
                    type: document.getElementById('nl-type').value,
                    customer_name: document.getElementById('nl-name').value || null,
                    associated_domain: document.getElementById('nl-domain').value || '*',
                    max_devices: parseInt(document.getElementById('nl-devices').value) || 0,
                    tags: document
                        .getElementById('nl-tags')
                        .value.split(',')
                        .map(function (t) {
                            return t.trim();
                        })
                        .filter(function (t) {
                            return t !== '';
                        }),
                    customer_id: document.getElementById('nl-customer-id').value || null,
                    amount: document.getElementById('nl-amount').value || null,
                };
                var exp = document.getElementById('nl-expires').value;
                if (exp)
                    body.expires_at = new Date(exp).toISOString().slice(0, 19).replace('T', ' ');
                API('/admin/licenses', { method: 'POST', body: JSON.stringify(body) })
                    .then(function () {
                        closeModal('modal-new-license');
                        loadLicenses();
                    })
                    .catch(function (e) {
                        showError(e.message || String(e));
                    });
            }

            // ── Customers ────────────────────────────────────────────────────────────────
            function loadCustomers(page) {
                if (page !== undefined) custPage = page;
                document.getElementById('cust-table').innerHTML = skeletonTable(6);
                var showArchived =
                    document.getElementById('cust-show-archived') &&
                    document.getElementById('cust-show-archived').checked;
                var url =
                    '/admin/customers?page=' +
                    custPage +
                    '&limit=25' +
                    (showArchived ? '&include_archived=1' : '');
                if (custSearch) url += '&search=' + encodeURIComponent(custSearch);

                API(url)
                    .then(function (d) {
                        CUSTS = d.customers || [];
                        var pag = d.pagination || { page: 1, pages: 1 };
                        var html = CUSTS.length
                            ? '<table class="data-table"><thead><tr><th>Name</th><th>E-Mail</th><th>Firma</th><th>Telefon</th><th>Zahlung</th><th>Status</th><th>Seit</th><th>Aktionen</th></tr></thead><tbody>' +
                              CUSTS.map(function (c, idx) {
                                  var isArchived = c.archived == 1 || c.archived === true;
                                  return (
                                      '<tr' +
                                      (isArchived ? ' style="opacity:.55"' : '') +
                                      '>' +
                                      '<td>' +
                                      esc(c.name) +
                                      (isArchived
                                          ? ' <span class="badge badge-archived">archiviert</span>'
                                          : '') +
                                      '</td>' +
                                      '<td>' +
                                      esc(c.email || '\u2014') +
                                      '</td>' +
                                      '<td>' +
                                      esc(c.company || '\u2014') +
                                      '</td>' +
                                      '<td>' +
                                      esc(c.phone || '\u2014') +
                                      '</td>' +
                                      '<td><span class="badge ' +
                                      (c.payment_status === 'paid'
                                          ? 'badge-active'
                                          : c.payment_status === 'overdue'
                                            ? 'badge-revoked'
                                            : 'badge-free') +
                                      '">' +
                                      esc(c.payment_status || '\u2014') +
                                      '</span></td>' +
                                      '<td>' +
                                      (isArchived
                                          ? '<span class="badge badge-archived">Archiviert</span>'
                                          : '<span class="badge badge-active">Aktiv</span>') +
                                      '</td>' +
                                      '<td>' +
                                      fmtDate(c.created_at) +
                                      '</td>' +
                                      '<td style="white-space:nowrap">' +
                                      '<button class="btn btn-ghost btn-xs" onclick="openEditCustomer(' +
                                      idx +
                                      ')">Bearbeiten</button> ' +
                                      '<button class="btn btn-primary btn-xs" onclick="openCreateLicenseForCustomer(\'' +
                                      esc(c.id) +
                                      '\')" >+ Lizenz</button> ' +
                                      '<button class="btn btn-ghost btn-xs" onclick="filterPurchaseByCustomer(\'' +
                                      esc(c.id) +
                                      '\')" >Käufe</button> ' +
                                      (isArchived
                                          ? '<button class="btn btn-success btn-xs" onclick="toggleArchiveCustomer(\'' +
                                            esc(c.id) +
                                            '\',false)" >Reaktivieren</button>'
                                          : '<button class="btn btn-warning btn-xs" onclick="toggleArchiveCustomer(\'' +
                                            esc(c.id) +
                                            '\',true)" >Archivieren</button>') +
                                      ' <button class="btn btn-danger btn-xs" onclick="deleteCustomer(\'' +
                                      esc(c.id) +
                                      '\')" >Löschen</button>' +
                                      '</td></tr>'
                                  );
                              }).join('') +
                              '</tbody></table>' +
                              renderPagination(pag, 'loadCustomers')
                            : emptyState('users', 'Keine Kunden', 'Lege deinen ersten Kunden an.', '+ Kunden anlegen', 'openNewCustomerModal()');
                        document.getElementById('cust-table').innerHTML = html;
                    })
                    .catch(function (e) {
                        document.getElementById('cust-table').innerHTML =
                            '<div class="alert alert-error" style="margin: var(--space-4)">' +
                            esc(e.message || 'Fehler') +
                            '</div>';
                    });
            }

            function filterCustomers() {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(function () {
                    custSearch = document.getElementById('cust-search').value;
                    custPage = 1;
                    loadCustomers();
                }, 400);
            }

            function openEditCustomer(idx) {
                var c = typeof idx === 'number' ? CUSTS[idx] : idx;
                if (!c) return;
                document.getElementById('ec-id').value = c.id;
                document.getElementById('ec-name').value = c.name || '';
                document.getElementById('ec-email').value = c.email || '';
                document.getElementById('ec-company').value = c.company || '';
                document.getElementById('ec-phone').value = c.phone || '';
                document.getElementById('ec-notes').value = c.notes || '';
                var payEl = document.getElementById('ec-payment');
                if (payEl) payEl.value = c.payment_status || 'unknown';
                document.getElementById('ec-alert').innerHTML = '';

                var licBlock = document.getElementById('ec-licenses-block');
                if (licBlock) {
                    licBlock.innerHTML =
                        '<div class="spinner" style="width:20px;height:20px;margin-bottom: var(--space-3);display:inline-block;vertical-align:middle"></div> <span style="font-size: var(--text-sm);color:var(--text2);vertical-align:middle;margin-left: var(--space-2)">Lade Lizenzen...</span>';
                    API('/admin/licenses?customer_id=' + encodeURIComponent(c.id))
                        .then(function (d) {
                            var myLics = d.licenses || [];
                            var html =
                                '<div style="font-size: var(--text-sm);font-weight:700;letter-spacing: 0.08em;color:var(--primary);text-transform:uppercase;margin-bottom: var(--space-2)">Lizenzen</div>';
                            if (myLics.length === 0) {
                                html +=
