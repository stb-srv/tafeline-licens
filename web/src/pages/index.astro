            function openCreateLicenseForCustomer(customerId) {
                var c = CUSTS.find(function (x) {
                    return x.id === customerId;
                });
                if (!c) return;

                document.getElementById('nl-customer-id').value = c.id;
                document.getElementById('nl-name').value = c.name || '';
                document.getElementById('nl-domain').value = '';
                document.getElementById('nl-tags').value = '';
                document.getElementById('nl-devices').value = '0';
                document.getElementById('nl-expires').value = '';

                var typeEl = document.getElementById('nl-type');
                if (typeEl) {
                    typeEl.value = 'FREE';
                    loadPlanInfo(typeEl.value);
                }

                var infoEl = document.getElementById('nl-customer-info');
                var displayEl = document.getElementById('nl-customer-display');
                if (infoEl && displayEl) {
                    infoEl.style.display = '';
                    displayEl.value = c.name + (c.company ? ' (' + c.company + ')' : '');
                }

                openModal('modal-new-license');
            }

