{
  "name": "tafeline-license-server",
  "version": "2.1.1",
  "description": "Central license management server for Tafeline CMS",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "prestart": "npm run build:web",
    "start": "node init.js && node server.js",
    "dev": "node init.js && node --watch server.js",
    "setup-db": "node setup-db.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "backup": "node -e \"import('./server/backup.js').then(m=>m.runBackup()).then(p=>console.log('Backup:',p))\"",
    "restore": "node restore.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tafeline/plans": "github:stb-srv/tafeline-plans",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.15",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1"
  }
}
